# ─────────────────────────────────────────────────────────────
#  Ali Arshad — Personal Studio · environment template
#  Copy to .env.local for local work; add the same keys in
#  Vercel → Project → Settings → Environment Variables.
#  Never commit real secret values to git.
# ─────────────────────────────────────────────────────────────

# Public production URL, no trailing slash. Enables canonical URLs,
# absolute Open Graph URLs and the sitemap host. Set this to the primary
# canonical domain in Vercel's Production environment so previews canonicalise
# to production instead of competing with it.
NEXT_PUBLIC_SITE_URL=https://www.aliarshad.co

# Optional public contact email shown on /contact (leave empty to hide it on the page).
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Transactional Email Delivery via Resend (https://resend.com) ──────────
# Powers BOTH the Contact form (/api/inquiry → "[Contact Inquiry] ...")
# and the Studio Network registration form (/api/studio-network → "[Studio Network Application] ...").
# Until all three Resend variables (or a webhook below) are set on the server,
# both forms show an honest "not connected yet" notice and never fake success.

# Secret API key created in Resend → API Keys (starts with "re_"). Server-only.
RESEND_API_KEY=

# Destination inbox that receives form submissions (e.g. a.arshad3001@gmail.com).
INQUIRY_TO_EMAIL=

# Verified sender address on your verified Resend domain (required for production),
# e.g. "Ali Arshad Studio <hello@aliarshad.co>" or "Ali Arshad Studio <notifications@aliarshad.co>".
# (Resend's sandbox sender "onboarding@resend.dev" only delivers to your own Resend account email during testing.)
INQUIRY_FROM_EMAIL=

# ── Optional Studio Network email overrides (automatically fall back to INQUIRY_* above) ──
STUDIO_NETWORK_TO_EMAIL=
STUDIO_NETWORK_FROM_EMAIL=

# ── Optional Webhook Delivery (n8n, Make, Zapier, CRM endpoint, etc.) ─────
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
STUDIO_NETWORK_WEBHOOK_URL=
STUDIO_NETWORK_WEBHOOK_SECRET=

# ═════════════════════════════════════════════════════════════
#  PRIVATE STUDIO ADMIN CONSOLE (/admin) — SERVER-ONLY SECRETS
#  See docs/ADMIN_CONSOLE_SETUP.md for full setup instructions.
# ═════════════════════════════════════════════════════════════

# Single authorized studio owner email allowed to sign into /admin.
ADMIN_EMAIL=

# Salted scrypt password hash (`scrypt$<saltHex>$<hashHex>`).
# Generate locally with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# 32+ character random secret used to HMAC-sign HTTP-only admin session cookies.
ADMIN_SESSION_SECRET=

# Optional dedicated 32+ char key for AES-256-GCM encryption of OAuth tokens at rest in Neon.
# Falls back to ADMIN_SESSION_SECRET if omitted.
ADMIN_ENCRYPTION_KEY=

# Local development ONLY: set to "true" to preview explicitly labeled synthetic demo records
# when live services are not connected yet. Keep unset or "false" in Production.
ADMIN_DEMO_MODE=false

# ── Neon PostgreSQL (https://neon.tech) ───────────────────────────────────
# Pooled connection string for Vercel serverless runtime requests.
DATABASE_URL=

# Direct (unpooled) connection string used by `npm run admin:migrate`.
DIRECT_DATABASE_URL=

# ── Optional Upstash Redis REST Rate Limiter (https://upstash.com) ────────
# Recommended for distributed Vercel serverless rate limiting on /api/admin/auth/login
# and outbound send/publish endpoints. Falls back safely to in-memory limiting when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Self-Hosted Listmonk Email Campaigns (https://listmonk.app) ───────────
# Base HTTPS URL of your self-hosted Listmonk instance (e.g. https://mail.yourdomain.com).
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Safety gate: keep "false" (default) during dev/preview so campaigns stay draft-only.
# Set to "true" ONLY in Production once you want confirmed live scheduling/sending enabled.
LISTMONK_ALLOW_LIVE_SEND=false

# ── Self-Hosted Postiz Social Publishing (https://postiz.com) ─────────────
# Base HTTPS URL of your self-hosted Postiz instance (e.g. https://social.yourdomain.com).
POSTIZ_URL=
POSTIZ_API_KEY=
# Safety gate: keep "false" (default) during dev/preview so social posts stay draft-only.
# Set to "true" ONLY in Production once you want confirmed live scheduling/publishing enabled.
POSTIZ_ALLOW_LIVE_PUBLISH=false

# ── Self-Hosted Twenty CRM (https://twenty.com) ───────────────────────────
# Base HTTPS URL of your self-hosted Twenty CRM instance (e.g. https://crm.yourdomain.com).
TWENTY_URL=
TWENTY_API_KEY=

# ── Official Google OAuth 2.0 for Gmail Read-Only Preview ─────────────────
# Create an OAuth Web Client in Google Cloud Console with redirect URI:
#   https://www.aliarshad.co/api/admin/gmail/callback
#   http://localhost:3000/api/admin/gmail/callback (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override; otherwise derived from request origin.
GOOGLE_REDIRECT_URI=

# ── Optional Read-Only GitHub API Status ──────────────────────────────────
GITHUB_USERNAME=
# Optional fine-grained read-only personal access token (improves API rate limit).
GITHUB_TOKEN=
