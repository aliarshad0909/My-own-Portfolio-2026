# ─────────────────────────────────────────────────────────────
#  Ali Arshad — Personal Studio · environment template
#  Copy to .env.local for local work; add the same keys in
#  Vercel → Project → Settings → Environment Variables.
#  Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public production URL, no trailing slash. Enables canonical URLs,
# absolute Open Graph URLs and the sitemap host.
NEXT_PUBLIC_SITE_URL=

# Public contact email shown on /contact (leave empty to hide it).
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Inquiry delivery (configure at least ONE channel) ─────────
# Until one channel is configured, the contact form shows an honest
# "not connected yet" notice and never reports a fake success.

# Option A — webhook (n8n, Make, Zapier, a CRM endpoint, etc.)
# Receives a JSON POST with the validated inquiry.
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the "x-inquiry-secret" header so the
# receiving workflow can reject requests that did not come from this site.
INQUIRY_WEBHOOK_SECRET=

# Option B — email via Resend (https://resend.com)
RESEND_API_KEY=
# Address that receives inquiries
INQUIRY_TO_EMAIL=
# Verified sender, e.g. "Ali Arshad Studio <studio@yourdomain.com>"
INQUIRY_FROM_EMAIL=
