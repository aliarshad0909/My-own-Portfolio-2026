# PostgreSQL connection string (leave blank locally to use persisted PGlite in ./data/pgdata)
# INSIGHTOS_DATABASE_URL takes precedence over DATABASE_URL
INSIGHTOS_DATABASE_URL=
DATABASE_URL=

# Set to "false" only for self-signed dev databases; leave unset/true in production
PGSSL_REJECT_UNAUTHORIZED=true

# Minimum 32 random characters required in production with external PostgreSQL
SESSION_SECRET=replace-with-at-least-32-random-characters-in-production

# Public origin URL for CSRF checks in production
NEXT_PUBLIC_APP_URL=http://localhost:3090

# Allow demo workspace reset endpoint ("true" | "false")
ALLOW_DEMO_RESET=true
