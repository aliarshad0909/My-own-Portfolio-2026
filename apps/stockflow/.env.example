# StockFlow Inventory SaaS — Production Environment Variables
# Copy to .env.local for local PostgreSQL testing. Never commit real secrets.

# Required in production (Neon Free PostgreSQL pooled URL with ?sslmode=require):
STOCKFLOW_DATABASE_URL=
# Fallback if STOCKFLOW_DATABASE_URL is not set:
# DATABASE_URL=

# Required in production (>= 32 random bytes, e.g. `openssl rand -hex 32`):
SESSION_SECRET=

# Public canonical URL of the deployed StockFlow web + REST API backend:
NEXT_PUBLIC_APP_URL=https://stock.aliarshad.co

# Allowed CORS origin for /api/v1/* Bearer clients ("*" or specific web preview origin):
CORS_ALLOWED_ORIGINS=*

# Set to "false" to disable the public demo reset endpoint:
ALLOW_DEMO_RESET=true

# Local PGlite storage path (used ONLY in local dev when database URL is empty):
# PGLITE_DATA_DIR=./data/pgdata
