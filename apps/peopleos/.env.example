# PostgreSQL connection string (leave blank locally to use persisted PGlite in ./data/pgdata)
DATABASE_URL=
PEOPLEOS_DATABASE_URL=

# Set to "false" only if your managed DB uses a self-signed certificate
PGSSL_REJECT_UNAUTHORIZED=true

# Required in production (at least 32 random characters)
SESSION_SECRET=change-me-to-a-32-plus-character-random-secret-value

# Canonical public URL used for CSRF Origin verification
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Demo controls ("false" disables /api/demo/reset and role-view switching)
ALLOW_DEMO_RESET=true
