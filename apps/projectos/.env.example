# ProjectOS Environment Configuration
# Leave PROJECTOS_DATABASE_URL / DATABASE_URL empty in local dev to use embedded PGlite (./data/pgdata).
# In Render / production, provide a PostgreSQL connection string and a 32+ char SESSION_SECRET.

PROJECTOS_DATABASE_URL=
DATABASE_URL=
PGSSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=replace-with-at-least-32-random-characters-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3080
ALLOW_DEMO_RESET=true
