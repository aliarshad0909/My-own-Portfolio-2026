# SupportOS — Customer Support & Help Desk SaaS Environment Configuration

# PostgreSQL connection string (leave blank locally to use embedded persisted PGlite in ./data/pgdata)
# SUPPORTOS_DATABASE_URL takes precedence over DATABASE_URL when both are set.
SUPPORTOS_DATABASE_URL=
DATABASE_URL=

# Set to "false" only if connecting to a self-signed dev PostgreSQL certificate
PGSSL_REJECT_UNAUTHORIZED=true

# Optional override for local PGlite storage path (use "memory://" for ephemeral tests)
PGLITE_DATA_DIR=

# Session signing secret (MUST be >= 32 random characters in production)
SESSION_SECRET=replace-with-at-least-32-characters-of-random-entropy

# Public canonical URL used for CSRF Origin validation
NEXT_PUBLIC_APP_URL=http://localhost:3070

# Set to "false" to disable the public Demo Workspace Reset endpoint
ALLOW_DEMO_RESET=true
