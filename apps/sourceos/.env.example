# SourceOS Environment Configuration
# Leave SOURCEOS_DATABASE_URL / DATABASE_URL unset locally to use embedded persisted PGlite (./data/pgdata).
SOURCEOS_DATABASE_URL=
DATABASE_URL=

# Set to "false" ONLY if your PostgreSQL provider requires self-signed certs
PGSSL_REJECT_UNAUTHORIZED=true

# Required in production (minimum 32 random characters)
SESSION_SECRET=replace-with-at-least-32-random-characters-for-production

# Public origin used for CSRF validation
NEXT_PUBLIC_APP_URL=http://localhost:3050

# Allow demo workspace reset endpoint (defaults to enabled unless set to "false")
ALLOW_DEMO_RESET=true
