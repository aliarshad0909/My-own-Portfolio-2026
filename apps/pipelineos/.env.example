# PipelineOS CRM — Production Environment Variables
# Copy to .env.local for local PostgreSQL testing. Never commit real secrets.

# Required in production (Neon Free PostgreSQL pooled URL with ?sslmode=require):
DATABASE_URL=

# Optional app-specific override (takes precedence over DATABASE_URL):
# PIPELINEOS_DATABASE_URL=

# Required in production (>= 32 random bytes, e.g. `openssl rand -hex 32`):
SESSION_SECRET=

# Public canonical URL of the deployed CRM:
NEXT_PUBLIC_APP_URL=https://crm.aliarshad.co

# Set to "false" to disable the public demo reset endpoint:
ALLOW_DEMO_RESET=true

# Local PGlite storage path (used ONLY in local dev when DATABASE_URL is empty):
# PGLITE_DATA_DIR=./data/pgdata
