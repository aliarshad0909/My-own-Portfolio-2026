# PostgreSQL connection string (Neon, Supabase, or self-hosted PostgreSQL).
# Leave empty in local development to use persisted on-disk PGlite PostgreSQL (./data/pgdata).
DATABASE_URL=

# Optional override for local PGlite storage path (defaults to ./data/pgdata).
PGLITE_DATA_DIR=

# Session signing secret (set a 32+ char random string in production).
SESSION_SECRET=replace-with-32-char-random-secret

# Optional public URL (e.g. https://crm.aliarshad.co)
NEXT_PUBLIC_APP_URL=http://localhost:3010

