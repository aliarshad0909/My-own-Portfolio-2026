# FlowOS — AI Workflow Automation Platform

# Optional PostgreSQL connection string. Leave blank locally to use persisted PGlite in ./data/pgdata.
FLOWOS_DATABASE_URL=
# DATABASE_URL=

# Required in production (RENDER=true or external Postgres): at least 32 random characters
SESSION_SECRET=change-me-to-a-32-plus-char-random-secret-in-production

# Public origin for CSRF origin verification
NEXT_PUBLIC_APP_URL=http://localhost:3040

# Demo reset endpoint toggle (defaults to true; set to false to lock workspace)
ALLOW_DEMO_RESET=true

# Optional: allow self-signed TLS certs only if explicitly required by your DB provider
# PGSSL_REJECT_UNAUTHORIZED=true

# Optional: server-side OpenAI-compatible API key (FlowOS runs 100% deterministically without any paid API key)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
