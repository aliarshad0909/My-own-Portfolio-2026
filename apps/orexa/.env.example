# PostgreSQL connection string (leave empty in local dev to use persisted PGlite in ./data/pgdata)
# On Render production, set OREXA_DATABASE_URL or DATABASE_URL to your Neon/PostgreSQL URL.
DATABASE_URL=
OREXA_DATABASE_URL=

# Set to "false" only if your Postgres provider uses a self-signed certificate
PGSSL_REJECT_UNAUTHORIZED=true

# Required in production (minimum 32 random characters)
SESSION_SECRET=replace-with-at-least-32-random-characters-in-production

# Canonical public URL used for CSRF origin allowlist
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3060

# Toggle one-click demo workspace reset ("true" or "false")
ALLOW_DEMO_RESET=true

# Optional server-side OpenAI-compatible LLM hook for AI Tutor.
# Leave unset to run 100% locally in Deterministic Curriculum-Grounded Tutor mode (zero paid API keys required).
OREXA_LLM_API_KEY=
OREXA_LLM_BASE_URL=
OREXA_LLM_MODEL=
