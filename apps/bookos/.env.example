# PostgreSQL connection string (leave blank locally to use embedded PGlite in ./data/pgdata)
BOOKOS_DATABASE_URL=
DATABASE_URL=

# Required in production (>= 32 random chars)
SESSION_SECRET=replace-with-at-least-32-random-characters-for-production

# Public origin for CSRF protection
NEXT_PUBLIC_APP_URL=http://localhost:3110

# Demo workspace reset toggle ("true" or "false")
ALLOW_DEMO_RESET=true

# Optional: override PGlite storage path (use "memory://" for tests)
PGLITE_DATA_DIR=
